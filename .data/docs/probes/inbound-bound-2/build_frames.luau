--!nocheck
-- Builds every frame body of the shape set with the milestone's own encoder (srcA: the scratch copy whose codec
-- modules see rbx.luau's "build" stand-ins, so values of Roblox types pass the encoder's typeof checks) and prints
-- a Luau module of hex bodies. run.sh redirects it into WORK_DIR/frames_data.luau (never into the repo); the
-- timing probes tag these bodies themselves. Run from WORK_DIR: luau -O2 build_frames.luau > frames_data.luau

local Lync = require("./srcA")
local M = {
	Bits = require("./srcA/wire/bits"), Ints = require("./srcA/wire/ints"), Run = require("./srcA/codec/run"),
	Frame = require("./srcA/transport/frame"), Tag = require("./srcA/transport/tag"),
	Connection = require("./srcA/session/connection"), Handshake = require("./srcA/session/handshake"),
	Counters = require("./srcA/diag/counters"), Console = require("./srcA/diag/console"),
	Facts = require("./srcA/diag/facts"), Column = require("./srcA/wire/column"),
}
local R = require("./rbx_build")
math.randomseed(7)
local S = require("./shapes")(Lync, R)
local C = require("./common")(M, S.schema.ir)
local Frame = M.Frame

local LIMIT = 16384 - 2 -- the milestone's frame limit less its 2-byte tag

local function bodyOf(chunks)
	return Frame.up(0, nil, nil, chunks)
end

local function hexOf(b)
	local parts = table.create(buffer.len(b))
	for i = 0, buffer.len(b) - 1 do
		parts[i + 1] = string.format("%02x", buffer.readu8(b, i))
	end
	return table.concat(parts)
end

print("-- GENERATED by build_frames.luau: frame bodies (before the tag) of the shape set, reliable lane")
print("return {")
for _, case in S.cases do
	local pool = table.create(case.cap)
	for i = 1, case.cap do
		pool[i] = if case.value then case.value() else nil
	end
	local body, list, count
	if case.form == "runs" then
		local chunks = {}
		local best = nil
		for i = 1, case.cap do
			chunks[i] = C.chunkOf(if i % 2 == 1 then case.a else case.b, { pool[i] }, 1)
			local b, l = bodyOf(chunks)
			if buffer.len(b) > LIMIT then
				break
			end
			best = { b, l, i }
		end
		body, list, count = best[1], best[2], best[3]
	else
		local function at(n)
			local b, l = bodyOf({ C.chunkOf(case.a, pool, n) })
			return b, l
		end
		local lo, hi = 1, case.cap
		if buffer.len((at(hi))) <= LIMIT then
			lo = hi
		else
			while hi - lo > 1 do
				local mid = (lo + hi) // 2
				if buffer.len((at(mid))) <= LIMIT then lo = mid else hi = mid end
			end
		end
		body, list = at(lo)
		count = lo
		assert(buffer.len(body) <= LIMIT, case.name .. " does not fit")
	end
	print(string.format("{ name = %q, kind = %q, n = %d, form = %q, msgs = %d, instances = %d, body = %q },",
		case.name, case.kind, case.n, case.form, count, #list, hexOf(body)))
end
print("}")

--!nocheck
-- Writes the generated upstream decoder for shapes.luau's schema to stdout (run.sh: WORK_DIR/gen_decoders.luau).
--
-- What "generated" means (research/generation-methods.md G1/G2; probes/inbound-budgets/gen.py): per definition,
-- straight-line reads at a bit cursor kept in upvalues, widths, bounds, names and items as constants, one table
-- constructor per record, no codec-kind dispatch at run time. Shared helpers are plain local functions: EG-0, the
-- column reader (wire/column.luau's format, ported from gen.py with the interval's low end), the tail reader, and the
-- milestone's own leaf math where the wire needs it (Quant.unnumber/unangle, Leaves.canonicalRotation,
-- directionOf, color3Of, f32Of, f64Of, instanceOf, robloxEnumOf). Every codec kind the shape set uses, in row
-- form (runs of 1-2 messages, arrays and maps of 1-2 elements) and column form (3 or more), with the milestone's
-- rules (v5.md §4.8: 2-7, 9, 10). decode_cost.luau checks that it returns the milestone's values, message count
-- and element count on every frame it times. Limits of this generator (not reached by the shape set): EG codes of
-- 32+ leading zero bits are refused, t.custom and t.convert are not generated.
-- Run from WORK_DIR: luau -O2 gen.luau > gen_decoders.luau

local Lync = require("./src")
local R = require("./rbx_fast")
math.randomseed(7)
local S = require("./shapes")(Lync, R)
local IR = S.schema.ir

local out = {}
local function emit(s)
	table.insert(out, s)
end
local function num(x)
	if x == math.floor(x) and math.abs(x) < 2 ^ 53 then
		return string.format("%d", x)
	end
	return string.format("%.17g", x)
end
local function key(name)
	return string.format("[%q]", name)
end

local HEAD = [==[
--!optimize 2
--!nocheck
-- GENERATED by gen.luau: the build's upstream decoder for shapes.luau's schema (see gen.luau's header).
local Leaves = require("./src/codec/leaves")
local Quant = require("./src/wire/quant")
local Ints = require("./src/wire/ints")
local readbits = buffer.readbits
local readstring = buffer.readstring
local bcreate = buffer.create
local bcopy = buffer.copy
local countrz = bit32.countrz
local vcreate = vector.create
local tcreate = table.create
local tmove = table.move
local unnumber = Quant.unnumber
local unangle = Quant.unangle
local f32Of = Leaves.f32Of
local f64Of = Leaves.f64Of
local canonicalRotation = Leaves.canonicalRotation
local directionOf = Leaves.directionOf
local color3Of = Leaves.color3Of
local robloxEnumOf = Leaves.robloxEnumOf
local instanceOf = Leaves.instanceOf
local instanceWidth = Leaves.instanceWidth
local unzigzag = Ints.unzigzag
local SHIM_BYVALUE = {}
for _, item in require("./rbx_fast").ShimEnumItems do SHIM_BYVALUE[item.Value] = item end

local G = {}

local B: buffer = buffer.create(0)
local P = 0 -- bit cursor
local S = 0 -- tail cursor, in bits
local BUDGET = 0
local DEFS: { number } = {}
local VALS: { any } = {}
local N = 0
local MISSES = {}
local ROW = 0
local CHUNK = { list = {}, offset = 0, count = 0, firstSeen = 0 }
local CW = 0 -- the chunk's instance index width

local function u(w: number): number?
	local p = P
	local q = p + w
	if q > S then return nil end
	P = q
	if w == 0 then return 0 end
	return readbits(B, p, w)
end

local function u53(w: number): number?
	if w <= 32 then return u(w) end
	local lo = u(32)
	local hi = u(w - 32)
	if lo == nil or hi == nil then return nil end
	return lo + hi * 4294967296
end

-- EG-0; nil and 4 on running out, 2 on a code of 32+ zero bits
local function eg0(): (number?, number)
	local p = P
	local avail = S - p
	if avail <= 0 then return nil, 4 end
	local win = readbits(B, p, if avail < 32 then avail else 32)
	if win == 0 then return nil, if avail < 32 then 4 else 2 end
	local z = countrz(win)
	local q = p + 2 * z + 1
	if q > S then return nil, 4 end
	P = q
	if z == 0 then return 0, 0 end
	return 2 ^ z - 1 + readbits(B, p + z + 1, z), 0
end

local function tail(length: number, asBuffer: boolean): any
	local start = S // 8 - length
	if start < (P + 7) // 8 then return nil end
	S = start * 8
	if not asBuffer then return readstring(B, start, length) end
	local value = bcreate(length)
	bcopy(value, 0, B, start, length)
	return value
end

local RES: { number } = {}

-- One integer column of `count` codes in [lo, lo + n - 1] into out[1..count] (wire/column.luau)
local function col(count: number, lo: number, n: number, out: { any }): number
	if count == 0 then return 0 end
	local mode = u(2)
	if mode == nil then return 4 end
	local maxCode = n - 1
	local res = RES
	if mode == 0 then
		for i = 1, count do res[i] = 0 end
	elseif mode == 3 then
		local base, rule = eg0()
		if base == nil then return rule end
		local width = u(6)
		if width == nil then return 4 end
		if width > 53 then return 2 end
		if width <= 32 then
			for i = 1, count do
				local p = P
				local q = p + width
				if q > S then return 4 end
				P = q
				local v = base + (if width == 0 then 0 else readbits(B, p, width))
				if v > maxCode then return 2 end
				res[i] = v
			end
		else
			for i = 1, count do
				local v0 = u53(width)
				if v0 == nil then return 4 end
				local v = base + v0
				if v > maxCode then return 2 end
				res[i] = v
			end
		end
	elseif mode == 1 then
		local k = u(4)
		if k == nil then return 4 end
		local scale = 2 ^ k
		for i = 1, count do
			local q, rule = eg0()
			if q == nil then return rule end
			local r = u(k)
			if r == nil then return 4 end
			local v = q * scale + r
			if v > maxCode then return 2 end
			res[i] = v
		end
	else
		local k = u(4)
		if k == nil then return 4 end
		local scale = 2 ^ k
		local m, rule = eg0()
		if m == nil then return rule end
		if m > count then return 2 end
		for i = 1, count do res[i] = 0 end
		local row = 0
		for _ = 1, m do
			local gap, gapRule = eg0()
			if gap == nil then return gapRule end
			if gap > count - row - 1 then return 2 end
			row += gap + 1
			local q, qRule = eg0()
			if q == nil then return qRule end
			local r = u(k)
			if r == nil then return 4 end
			local v = q * scale + r
			if v > maxCode - 1 then return 2 end
			res[row] = v + 1
		end
	end
	local top = lo + n - 1
	local previous = 0
	for i = 1, count do
		local z = res[i]
		local residual = if z % 2 == 0 then z / 2 else -(z + 1) / 2
		local code
		if residual > top - previous then
			code = previous + (residual - n)
		elseif residual < lo - previous then
			code = previous + (residual + n)
		else
			code = previous + residual
		end
		out[i] = code
		previous = code
	end
	return 0
end

local function raw32(count: number, out: { any }): number
	for i = 1, count do
		local bits = u(32)
		if bits == nil then return 4 end
		local value = f32Of(bits)
		if value == nil then return 3 end
		out[i] = value
	end
	return 0
end

-- one t.rotation row (rows.luau readRotation)
local function rotRow(bits: number, x: number, y: number, z: number): (any, number)
	local flag = u(1)
	if flag == nil then return nil, 4 end
	local index, a, b, c = 0, 0, 0, 0
	if flag == 1 then
		local axisIndex = u(5)
		if axisIndex == nil then return nil, 4 end
		if axisIndex >= 24 then return nil, 2 end
		index = axisIndex
	else
		local dropped = u(2)
		local aCode = u(bits)
		local bCode = u(bits)
		local cCode = u(bits)
		if dropped == nil or aCode == nil or bCode == nil or cCode == nil then return nil, 4 end
		index, a, b, c = dropped, aCode, bCode, cCode
	end
	local rotation = canonicalRotation(flag, index, a, b, c, bits, x, y, z)
	if rotation == nil then return nil, 6 end
	return rotation, 0
end

-- a t.rotation column (columns.luau)
local RF, RA, RD, RCA, RCB, RCC = {}, {}, {}, {}, {}, {}
local function rotCol(bits: number, count: number, out: { any }): number
	local rule = col(count, 0, 2, RF)
	if rule ~= 0 then return rule end
	local axisCount = 0
	for i = 1, count do axisCount += RF[i] end
	local otherCount = count - axisCount
	local codes = 2 ^ bits
	rule = col(axisCount, 0, 24, RA)
	if rule == 0 then rule = col(otherCount, 0, 4, RD) end
	if rule == 0 then rule = col(otherCount, 0, codes, RCA) end
	if rule == 0 then rule = col(otherCount, 0, codes, RCB) end
	if rule == 0 then rule = col(otherCount, 0, codes, RCC) end
	if rule ~= 0 then return rule end
	local axisRow, otherRow = 0, 0
	for i = 1, count do
		local flag = RF[i]
		local index, a, b, c = 0, 0, 0, 0
		if flag == 1 then
			axisRow += 1
			index = RA[axisRow]
		else
			otherRow += 1
			index = RD[otherRow]
			a, b, c = RCA[otherRow], RCB[otherRow], RCC[otherRow]
		end
		local rotation = canonicalRotation(flag, index, a, b, c, bits, 0, 0, 0)
		if rotation == nil then return 6 end
		out[i] = rotation
	end
	return 0
end

local function push(def: number, value: any)
	local n = N + 1
	N = n
	DEFS[n] = def
	VALS[n] = value
end

local DECODE = {}
local UNRELIABLE = {}
local HAS_INSTANCES = {}
local NAMES = {}
]==]

-- the driver module: header, toc, run headers, chunks; each definition's runs are in their own module (gdefs/dN.luau),
-- so that the CLI's native code generator compiles each (one module of every definition is not compiled natively)
local driver = { "--@@FILE gen_decoders.luau", HEAD }
local function defModuleHead()
	return (string.gsub(string.gsub(HEAD, '"%./src/', '"../src/'), '"%./rbx_fast"', '"../rbx_fast"'))
end

-- Codegen -----------------------------------------------------------------------------------------------------------

local counter = 0
local function fresh(prefix)
	counter += 1
	return prefix .. counter
end

local isLeaf = {
	bool = true, int = true, varint = true, number = true, f32 = true, f64 = true, angle = true, enum = true,
	string = true, buffer = true, vector3 = true, vector3f32 = true, direction = true, rotation = true,
	cframe = true, color3 = true, robloxEnum = true, instance = true,
}

-- block-scoped declarations of the definition being generated (constants, scratch tables, node functions)
local decls

local function constTable(items)
	local name = fresh("K")
	local parts = {}
	for _, item in items do table.insert(parts, string.format("%q", item)) end
	table.insert(decls, string.format("local %s = { %s }", name, table.concat(parts, ", ")))
	return name
end
local function scratch()
	local name = fresh("SC")
	table.insert(decls, string.format("local %s = {}", name))
	return name
end

local rowFn, colFn -- forward

-- Lines that read one row value of a leaf codec into `dst`; failure returns `fail .. rule`.
local function leafRow(c, dst, L, fail)
	local k = c.kind
	local function f(rule) return "return " .. fail .. rule end
	if k == "bool" then
		L(string.format("do local c = u(1) if c == nil then %s end %s = c == 1 end", f(4), dst))
	elseif k == "int" then
		local check = if 2 ^ c.width - 1 + c.min > c.max then string.format(" if %s > %s then %s end", dst, num(c.max), f(3)) else ""
		L(string.format("do local c = u53(%d) if c == nil then %s end %s = c + %s%s end", c.width, f(4), dst, num(c.min), check))
	elseif k == "varint" then
		L(string.format("do local c, rr = eg0() if c == nil then %s end %s = unzigzag(c) end", f("rr"), dst))
	elseif k == "number" then
		L(string.format("do local c = u53(%d) if c == nil then %s end if c > %s then %s end %s = unnumber(c, %s, %s, %s) end",
			c.width, f(4), num(c.steps), f(2), dst, num(c.min), num(c.step), num(c.max)))
	elseif k == "f32" then
		L(string.format("do local c = u(32) if c == nil then %s end %s = f32Of(c) if %s == nil then %s end end", f(4), dst, dst, f(3)))
	elseif k == "f64" then
		L(string.format("do local lo = u(32) local hi = u(32) if lo == nil or hi == nil then %s end %s = f64Of(lo, hi) if %s == nil then %s end end", f(4), dst, dst, f(3)))
	elseif k == "angle" then
		L(string.format("do local c = u53(%d) if c == nil then %s end if c >= %s then %s end %s = unangle(c, %s) end", c.width, f(4), num(c.steps), f(2), dst, num(c.steps)))
	elseif k == "enum" then
		local items = constTable(c.items)
		L(string.format("do local c = u(%d) if c == nil then %s end %s = %s[c + 1] if %s == nil then %s end end", c.width, f(4), dst, items, dst, f(2)))
	elseif k == "string" or k == "buffer" then
		L(string.format("do local n = u(%d) if n == nil then %s end if n > %s then %s end %s = tail(n, %s) if %s == nil then %s end end",
			c.width, f(4), num(c.max), f(2), dst, tostring(k == "buffer"), dst, f(4)))
	elseif k == "vector3" then
		local a = c.axis
		L(string.format("do local x = u53(%d) local y = u53(%d) local z = u53(%d) if x == nil or y == nil or z == nil then %s end", a.width, a.width, a.width, f(4)))
		L(string.format("if x > %s or y > %s or z > %s then %s end", num(a.steps), num(a.steps), num(a.steps), f(2)))
		L(string.format("%s = vcreate(unnumber(x, %s, %s, %s), unnumber(y, %s, %s, %s), unnumber(z, %s, %s, %s)) end", dst,
			num(a.min), num(a.step), num(a.max), num(a.min), num(a.step), num(a.max), num(a.min), num(a.step), num(a.max)))
	elseif k == "vector3f32" then
		L(string.format("do local xb = u(32) local yb = u(32) local zb = u(32) if xb == nil or yb == nil or zb == nil then %s end", f(4)))
		L(string.format("local x, y, z = f32Of(xb), f32Of(yb), f32Of(zb) if x == nil or y == nil or z == nil then %s end %s = vcreate(x, y, z) end", f(3), dst))
	elseif k == "direction" then
		L(string.format("do local x = u(%d) local y = u(%d) if x == nil or y == nil then %s end %s = directionOf(x, y, %d) if %s == nil then %s end end",
			c.bits, c.bits, f(4), dst, c.bits, dst, f(6)))
	elseif k == "rotation" then
		L(string.format("do local rv, rr = rotRow(%d, 0, 0, 0) if rv == nil then %s end %s = rv end", c.bits, f("rr"), dst))
	elseif k == "cframe" then
		local pos = c.position
		if pos.kind == "vector3" then
			local a = pos.axis
			L(string.format("do local xc = u53(%d) local yc = u53(%d) local zc = u53(%d) if xc == nil or yc == nil or zc == nil then %s end", a.width, a.width, a.width, f(4)))
			L(string.format("if xc > %s or yc > %s or zc > %s then %s end", num(a.steps), num(a.steps), num(a.steps), f(2)))
			L(string.format("local rv, rr = rotRow(%d, unnumber(xc, %s, %s, %s), unnumber(yc, %s, %s, %s), unnumber(zc, %s, %s, %s)) if rv == nil then %s end %s = rv end",
				c.rotation.bits, num(a.min), num(a.step), num(a.max), num(a.min), num(a.step), num(a.max), num(a.min), num(a.step), num(a.max), f("rr"), dst))
		else
			L(string.format("do local xb = u(32) local yb = u(32) local zb = u(32) if xb == nil or yb == nil or zb == nil then %s end", f(4)))
			L(string.format("local x, y, z = f32Of(xb), f32Of(yb), f32Of(zb) if x == nil or y == nil or z == nil then %s end", f(3)))
			L(string.format("local rv, rr = rotRow(%d, x, y, z) if rv == nil then %s end %s = rv end", c.rotation.bits, f("rr"), dst))
		end
	elseif k == "color3" then
		L(string.format("do local r = u(8) local g = u(8) local b = u(8) if r == nil or g == nil or b == nil then %s end %s = color3Of(r, g, b) end", f(4), dst))
	elseif k == "robloxEnum" then
		L(string.format("do local c, rr = eg0() if c == nil then %s end %s = robloxEnumOf(unzigzag(c), SHIM_BYVALUE, MISSES, ROW) end", f("rr"), dst))
	elseif k == "instance" then
		L(string.format("do local c = u(CW) if c == nil then %s end local iv, rr = instanceOf(CHUNK, c, %s, MISSES, ROW) if rr ~= 0 then %s end %s = iv end",
			f(4), if c.class then string.format("%q", c.class) else "nil", f("rr"), dst))
	else
		error("gen: no row form for " .. k)
	end
end

-- Lines that read one row value of any codec into `dst`.
local function anyRow(c, dst, L, fail)
	if isLeaf[c.kind] then
		leafRow(c, dst, L, fail)
	elseif c.kind == "optional" then
		L(string.format("do local p = u(1) if p == nil then return %s4 end if p == 1 then", fail))
		anyRow(c.inner, dst, L, fail)
		L(string.format("else %s = nil end end", dst))
	else
		local fn = rowFn(c)
		L(string.format("do local rv, rr = %s() if rr ~= 0 then return %srr end %s = rv end", fn, fail, dst))
	end
end

-- A column read of any codec into `outName` for `countExpr` rows; failure returns the rule.
local function anyCol(c, countExpr, outName, L)
	local k = c.kind
	local function check(expr)
		L(string.format("do local rr = %s if rr ~= 0 then return rr end end", expr))
	end
	if k == "bool" then
		check(string.format("col(%s, 0, 2, %s)", countExpr, outName))
		L(string.format("for i = 1, %s do %s[i] = %s[i] == 1 end", countExpr, outName, outName))
	elseif k == "int" then
		check(string.format("col(%s, 0, %s, %s)", countExpr, num(c.max - c.min + 1), outName))
		if c.min ~= 0 then
			L(string.format("for i = 1, %s do %s[i] += %s end", countExpr, outName, num(c.min)))
		end
	elseif k == "varint" then
		check(string.format("col(%s, %s, %s, %s)", countExpr, num(-2 ^ 52), num(2 ^ 53), outName))
	elseif k == "number" then
		check(string.format("col(%s, 0, %s, %s)", countExpr, num(c.steps + 1), outName))
		L(string.format("for i = 1, %s do %s[i] = unnumber(%s[i], %s, %s, %s) end", countExpr, outName, outName, num(c.min), num(c.step), num(c.max)))
	elseif k == "angle" then
		check(string.format("col(%s, 0, %s, %s)", countExpr, num(c.steps), outName))
		L(string.format("for i = 1, %s do %s[i] = unangle(%s[i], %s) end", countExpr, outName, outName, num(c.steps)))
	elseif k == "enum" then
		local items = constTable(c.items)
		check(string.format("col(%s, 0, %d, %s)", countExpr, #c.items, outName))
		L(string.format("for i = 1, %s do %s[i] = %s[%s[i] + 1] end", countExpr, outName, items, outName))
	elseif k == "robloxEnum" then
		check(string.format("col(%s, %s, %s, %s)", countExpr, num(-2 ^ 52), num(2 ^ 53), outName))
		L(string.format("for i = 1, %s do %s[i] = robloxEnumOf(%s[i], SHIM_BYVALUE, MISSES, ROW) end", countExpr, outName, outName))
	elseif k == "instance" then
		L(string.format("if %s > 0 and CHUNK.count == 0 then return 2 end", countExpr))
		check(string.format("col(%s, 0, CHUNK.count, %s)", countExpr, outName))
		L(string.format("for i = 1, %s do local iv, rr = instanceOf(CHUNK, %s[i], %s, MISSES, ROW) if rr ~= 0 then return rr end %s[i] = iv end",
			countExpr, outName, if c.class then string.format("%q", c.class) else "nil", outName))
	elseif k == "string" or k == "buffer" then
		check(string.format("col(%s, 0, %s, %s)", countExpr, num(c.max + 1), outName))
		L(string.format("for i = 1, %s do local v = tail(%s[i], %s) if v == nil then return 4 end %s[i] = v end", countExpr, outName, tostring(k == "buffer"), outName))
	elseif k == "f32" then
		check(string.format("raw32(%s, %s)", countExpr, outName))
	elseif k == "f64" then
		L(string.format("for i = 1, %s do local lo = u(32) local hi = u(32) if lo == nil or hi == nil then return 4 end local v = f64Of(lo, hi) if v == nil then return 3 end %s[i] = v end", countExpr, outName))
	elseif k == "vector3" then
		local a = c.axis
		local ys, zs = scratch(), scratch()
		local n = num(a.steps + 1)
		check(string.format("col(%s, 0, %s, %s)", countExpr, n, outName))
		check(string.format("col(%s, 0, %s, %s)", countExpr, n, ys))
		check(string.format("col(%s, 0, %s, %s)", countExpr, n, zs))
		L(string.format("for i = 1, %s do %s[i] = vcreate(unnumber(%s[i], %s, %s, %s), unnumber(%s[i], %s, %s, %s), unnumber(%s[i], %s, %s, %s)) end",
			countExpr, outName, outName, num(a.min), num(a.step), num(a.max), ys, num(a.min), num(a.step), num(a.max), zs, num(a.min), num(a.step), num(a.max)))
	elseif k == "vector3f32" then
		local ys, zs = scratch(), scratch()
		check(string.format("raw32(%s, %s)", countExpr, outName))
		check(string.format("raw32(%s, %s)", countExpr, ys))
		check(string.format("raw32(%s, %s)", countExpr, zs))
		L(string.format("for i = 1, %s do %s[i] = vcreate(%s[i], %s[i], %s[i]) end", countExpr, outName, outName, ys, zs))
	elseif k == "color3" then
		local gs, bs = scratch(), scratch()
		check(string.format("col(%s, 0, 256, %s)", countExpr, outName))
		check(string.format("col(%s, 0, 256, %s)", countExpr, gs))
		check(string.format("col(%s, 0, 256, %s)", countExpr, bs))
		L(string.format("for i = 1, %s do %s[i] = color3Of(%s[i], %s[i], %s[i]) end", countExpr, outName, outName, gs, bs))
	elseif k == "direction" then
		local ys = scratch()
		check(string.format("col(%s, 0, %s, %s)", countExpr, num(2 ^ c.bits), outName))
		check(string.format("col(%s, 0, %s, %s)", countExpr, num(2 ^ c.bits), ys))
		L(string.format("for i = 1, %s do local v = directionOf(%s[i], %s[i], %d) if v == nil then return 6 end %s[i] = v end", countExpr, outName, ys, c.bits, outName))
	elseif k == "rotation" then
		check(string.format("rotCol(%d, %s, %s)", c.bits, countExpr, outName))
	elseif k == "cframe" then
		local ps = scratch()
		anyCol(c.position, countExpr, ps, L)
		check(string.format("rotCol(%d, %s, %s)", c.rotation.bits, countExpr, outName))
		L(string.format("for i = 1, %s do %s[i] += %s[i] end", countExpr, outName, ps))
	else
		local fn = colFn(c)
		check(string.format("%s(%s, %s)", fn, countExpr, outName))
	end
end

-- the row function of a record (or a union variant, with its kind)
local function recordRowBody(fields, kindName, L)
	local names = {}
	for i, field in fields do
		local v = "v" .. i
		L(string.format("local %s", v))
		anyRow(field.codec, v, L, "nil, ")
		table.insert(names, string.format("%s = %s", key(field.name), v))
	end
	if kindName then
		table.insert(names, 1, string.format("kind = %q", kindName))
	end
	L(string.format("return { %s }, 0", table.concat(names, ", ")))
end

local fnCache = {}

-- structurally identical codecs share their functions within a definition
local keyCache = {}
local function shapeKey(c)
	if keyCache[c] then return keyCache[c] end
	local parts = { c.kind }
	for k, v in c do
		if type(v) == "number" or type(v) == "string" or type(v) == "boolean" then
			table.insert(parts, k .. "=" .. tostring(v))
		end
	end
	table.sort(parts)
	if c.kind == "record" then
		for _, f in c.fields do table.insert(parts, f.name .. ":" .. shapeKey(f.codec)) end
	elseif c.kind == "union" then
		for _, v in c.variants do table.insert(parts, v.name .. ":" .. shapeKey(v.record)) end
	elseif c.kind == "enum" then
		table.insert(parts, table.concat(c.items, "|"))
	elseif c.inner then
		table.insert(parts, "inner:" .. shapeKey(c.inner))
	elseif c.kind == "map" then
		table.insert(parts, "key:" .. shapeKey(c.key) .. ",value:" .. shapeKey(c.value))
	elseif c.axis then
		table.insert(parts, "axis:" .. shapeKey(c.axis))
	elseif c.kind == "cframe" then
		table.insert(parts, "pos:" .. shapeKey(c.position) .. ",rot:" .. shapeKey(c.rotation))
	end
	local key = "{" .. table.concat(parts, ";") .. "}"
	keyCache[c] = key
	return key
end

function rowFn(c)
	local cacheKey = "row" .. shapeKey(c)
	if fnCache[cacheKey] then return fnCache[cacheKey] end
	local name = fresh("r")
	fnCache[cacheKey] = name
	local body = {}
	local function L(s) table.insert(body, "\t" .. s) end
	if c.kind == "record" then
		recordRowBody(c.fields, nil, L)
	elseif c.kind == "union" then
		L(string.format("local c = u(%d) if c == nil then return nil, 4 end", c.width))
		for i, variant in c.variants do
			L(string.format("%s c == %d then", if i == 1 then "if" else "elseif", i - 1))
			recordRowBody(variant.record.fields, variant.name, L)
		end
		L("end")
		L("return nil, 2")
	elseif c.kind == "array" then
		L(string.format("local n = u(%d) if n == nil then return nil, 4 end if n > %s then return nil, 2 end", c.width, num(c.max)))
		L("BUDGET -= n if BUDGET < 0 then return nil, 10 end")
		L("local a = tcreate(n)")
		L("if n >= 3 then")
		anyCol(c.inner, "n", "a", function(s) L("\t" .. s:gsub("return rr", "return nil, rr"):gsub("return (%d+)", "return nil, %1")) end)
		L("\treturn a, 0")
		L("end")
		L("for i = 1, n do local v")
		anyRow(c.inner, "v", L, "nil, ")
		L("a[i] = v end")
		L("return a, 0")
	elseif c.kind == "map" then
		local kc = c.key
		local idx = nil
		if kc.kind == "enum" then
			idx = fresh("KI")
			local parts = {}
			for i, item in kc.items do table.insert(parts, string.format("[%q] = %d", item, i)) end
			table.insert(decls, string.format("local %s = { %s }", idx, table.concat(parts, ", ")))
		end
		local function asc(a, b)
			if idx then return string.format("%s[%s] < %s[%s]", idx, a, idx, b) end
			return string.format("%s < %s", a, b)
		end
		L(string.format("local n = u(%d) if n == nil then return nil, 4 end if n > %s then return nil, 2 end", c.width, num(c.max)))
		L("BUDGET -= n if BUDGET < 0 then return nil, 10 end")
		L("local m = {}")
		L("if n >= 3 then")
		local ks, vs = scratch(), scratch()
		local wrap = function(s) L("\t" .. s:gsub("return rr", "return nil, rr"):gsub("return (%d+)", "return nil, %1")) end
		anyCol(kc, "n", ks, wrap)
		anyCol(c.value, "n", vs, wrap)
		L(string.format("\tfor i = 1, n do local k = %s[i] if i > 1 and not (%s) then return nil, 5 end m[k] = %s[i] end", ks, asc(ks .. "[i - 1]", "k"), vs))
		L("\treturn m, 0")
		L("end")
		L("local prev = nil")
		L("for i = 1, n do local k, v")
		anyRow(kc, "k", L, "nil, ")
		L(string.format("if i > 1 and not (%s) then return nil, 5 end", asc("prev", "k")))
		anyRow(c.value, "v", L, "nil, ")
		L("m[k] = v prev = k end")
		L("return m, 0")
	elseif c.kind == "optional" then
		L("local v")
		anyRow(c, "v", L, "nil, ")
		L("return v, 0")
	else
		-- a leaf at the root of a definition
		L("local v")
		anyRow(c, "v", L, "nil, ")
		L("return v, 0")
	end
	table.insert(decls, string.format("local function %s(): (any, number)\n%s\nend", name, table.concat(body, "\n")))
	return name
end

local function recordColBody(fields, kindName, L)
	local cols = {}
	for i, field in fields do
		local sc = scratch()
		anyCol(field.codec, "count", sc, L)
		table.insert(cols, string.format("%s = %s[i]", key(field.name), sc))
	end
	if kindName then
		table.insert(cols, 1, string.format("kind = %q", kindName))
	end
	L(string.format("for i = 1, count do out[i] = { %s } end", table.concat(cols, ", ")))
	L("return 0")
end

function colFn(c)
	local cacheKey = "col" .. shapeKey(c)
	if fnCache[cacheKey] then return fnCache[cacheKey] end
	local name = fresh("c")
	fnCache[cacheKey] = name
	local body = {}
	local function L(s) table.insert(body, "\t" .. s) end
	L("if count == 0 then return 0 end")
	if c.kind == "record" then
		recordColBody(c.fields, nil, L)
	elseif c.kind == "optional" then
		local ps, qs = scratch(), scratch()
		L(string.format("do local rr = col(count, 0, 2, %s) if rr ~= 0 then return rr end end", ps))
		L(string.format("local present = 0 for i = 1, count do present += %s[i] end", ps))
		anyCol(c.inner, "present", qs, L)
		L(string.format("local j = 0 for i = 1, count do if %s[i] == 1 then j += 1 out[i] = %s[j] else out[i] = nil end end", ps, qs))
		L("return 0")
	elseif c.kind == "union" then
		L(string.format("do local rr = col(count, 0, %d, out) if rr ~= 0 then return rr end end", #c.variants))
		local nv = #c.variants
		local cnt = scratch()
		L(string.format("for v = 1, %d do %s[v] = 0 end", nv, cnt))
		L(string.format("for i = 1, count do local v = out[i] + 1 %s[v] += 1 end", cnt))
		local recs = {}
		for i, variant in c.variants do
			local rs = scratch()
			recs[i] = rs
			local vfn = fresh("cv")
			local vbody = {}
			local function VL(s) table.insert(vbody, "\t" .. s) end
			recordColBody(variant.record.fields, variant.name, VL)
			table.insert(decls, string.format("local function %s(count: number, out: { any }): number\n%s\nend", vfn, table.concat(vbody, "\n")))
			L(string.format("if %s[%d] > 0 then local rr = %s(%s[%d], %s) if rr ~= 0 then return rr end end", cnt, i, vfn, cnt, i, rs))
		end
		L(string.format("for v = 1, %d do %s[v] = 0 end", nv, cnt))
		local parts = {}
		for i, rs in recs do table.insert(parts, string.format("%s c == %d then out[i] = %s[t]", if i == 1 then "if" else "elseif", i - 1, rs)) end
		L(string.format("for i = 1, count do local c = out[i] local t = %s[c + 1] + 1 %s[c + 1] = t %s end end", cnt, cnt, table.concat(parts, " ")))
		L("return 0")
	elseif c.kind == "array" then
		local es = scratch()
		L(string.format("do local rr = col(count, 0, %s, out) if rr ~= 0 then return rr end end", num(c.max + 1)))
		L("local total = 0 for i = 1, count do total += out[i] end")
		L("BUDGET -= total if BUDGET < 0 then return 10 end")
		anyCol(c.inner, "total", es, L)
		L(string.format("local pos = 1 for i = 1, count do local n = out[i] local a = tcreate(n) tmove(%s, pos, pos + n - 1, 1, a) pos += n out[i] = a end", es))
		L("return 0")
	elseif c.kind == "map" then
		local kc = c.key
		local idx = nil
		if kc.kind == "enum" then
			idx = fresh("KI")
			local parts = {}
			for i, item in kc.items do table.insert(parts, string.format("[%q] = %d", item, i)) end
			table.insert(decls, string.format("local %s = { %s }", idx, table.concat(parts, ", ")))
		end
		local ks, vs = scratch(), scratch()
		L(string.format("do local rr = col(count, 0, %s, out) if rr ~= 0 then return rr end end", num(c.max + 1)))
		L("local total = 0 for i = 1, count do total += out[i] end")
		L("BUDGET -= total if BUDGET < 0 then return 10 end")
		anyCol(kc, "total", ks, L)
		anyCol(c.value, "total", vs, L)
		local cmp = if idx then string.format("%s[%s[j - 1]] < %s[k]", idx, ks, idx) else string.format("%s[j - 1] < k", ks)
		L(string.format("local pos = 0 for i = 1, count do local m = {} local n = out[i] for j = pos + 1, pos + n do local k = %s[j] if j > pos + 1 and not (%s) then return 5 end m[k] = %s[j] end pos += n out[i] = m end", ks, cmp, vs))
		L("return 0")
	else
		-- a leaf at the root of a definition
		anyCol(c, "count", "out", L)
		L("return 0")
	end
	table.insert(decls, string.format("local function %s(count: number, out: { any }): number\n%s\nend", name, table.concat(body, "\n")))
	return name
end

-- Definitions -------------------------------------------------------------------------------------------------------

local index = 0
for _, def in IR.definitions do
	if def.from ~= "client" or def.kind ~= "event" then
		continue
	end
	index += 1
	decls = {}
	table.clear(fnCache)
	local codec = def.data
	local rootDecl
	if codec == nil then
		rootDecl = "function(def, count) for _ = 1, count do push(def, nil) end return 0 end"
	else
		local rf = rowFn(codec)
		local cf = colFn(codec)
		local sc = scratch()
		rootDecl = string.format([[function(def, count)
	if count >= 3 then
		local rr = %s(count, %s)
		if rr ~= 0 then return rr end
		for i = 1, count do push(def, %s[i]) end
		return 0
	end
	for i = 1, count do
		ROW = i
		local v, rr = %s()
		if rr ~= 0 then return rr end
		push(def, v)
	end
	return 0
end]], cf, sc, sc, rf)
	end
	emit(string.format("--@@FILE gdefs/d%d.luau", index))
	emit(defModuleHead())
	emit(string.format("-- %s", def.name))
	for _, d in decls do emit(d) end
	emit(string.format("local ROOT = %s", rootDecl))
	emit([[return function(buf, p, s, budget, chunk, cw, defs, vals, n, def, count)
	B = buf P = p S = s BUDGET = budget CHUNK = chunk CW = cw DEFS = defs VALS = vals N = n
	local rule = ROOT(def, count)
	return rule, P, S, BUDGET, N
end]])
	table.insert(driver, string.format("DECODE[%d] = require(\"./gdefs/d%d\")", index, index))
	table.insert(driver, string.format("UNRELIABLE[%d] = %s", index, tostring(def.lane == "unreliable")))
	table.insert(driver, string.format("HAS_INSTANCES[%d] = %s", index, tostring(def.hasInstances)))
	table.insert(driver, string.format("NAMES[%d] = %q", index, def.name))
end

for _, line in driver do emit(line) end
emit([==[
local SEEN = {}

--[=[
	Decodes one tagged upstream frame (tag not checked here).
	@return rule (0 accepted), messages decoded, elements used; messages in G.defs / G.values at 1..n
]=]
function G.decodeUp(buf: buffer, lane: number, wireToDef: { number }, idWidth: number, budget: number, list: { any }, instanceCount: number): (number, number, number)
	local len = buffer.len(buf)
	if lane == 1 and len > 1000 then return 8, 0, 0 end
	if lane == 0 and len > 16384 then return 8, 0, 0 end
	if len < 2 then return 4, 0, 0 end
	B = buf
	P = 0
	S = (len - 2) * 8
	N = 0
	BUDGET = budget
	table.clear(MISSES)
	if lane == 1 then
		if u(12) == nil then return 4, 0, 0 end
	end
	local hasAck = u(1)
	if hasAck == nil then return 4, 0, 0 end
	if hasAck == 1 then
		if u(12) == nil or u(16) == nil then return 4, 0, 0 end
	end
	local segments, rule = eg0()
	if segments == nil then return rule, 0, 0 end
	local isUnreliable = lane == 1
	local previousNs = -1
	local nsList, countList = tcreate(segments), tcreate(segments)
	for i = 1, segments do
		local ns, nsRule = eg0()
		if ns == nil then return nsRule, 0, 0 end
		local c, cRule = eg0()
		if c == nil then return cRule, 0, 0 end
		if ns == previousNs then return 6, 0, 0 end
		previousNs = ns
		nsList[i] = ns
		countList[i] = c + 1
	end
	local offset = 0
	for i = 1, segments do
		if nsList[i] ~= 1 then return 7, 0, 0 end
		for _ = 1, countList[i] do
			local id = u(idWidth)
			if id == nil then return 4, 0, 0 end
			local def = wireToDef[id + 1]
			if def == nil or UNRELIABLE[def] ~= isUnreliable then return 7, 0, 0 end
			local countLessOne, countRule = eg0()
			if countLessOne == nil then return countRule, 0, 0 end
			local ic = 0
			if HAS_INSTANCES[def] then
				local readCount, icRule = eg0()
				if readCount == nil then return icRule, 0, 0 end
				ic = readCount
			end
			CHUNK = { list = list, offset = offset, count = ic, firstSeen = 0 }
			CW = instanceWidth(ic)
			local count = countLessOne + 1
			BUDGET -= count
			if BUDGET < 0 then return 10, N, budget - BUDGET end
			local runRule
			runRule, P, S, BUDGET, N = DECODE[def](B, P, S, BUDGET, CHUNK, CW, DEFS, VALS, N, def, count)
			if runRule ~= 0 then return runRule, N, budget - BUDGET end
			if CHUNK.firstSeen ~= ic then return 9, N, budget - BUDGET end
			for j = offset + 1, offset + ic do
				local instance = list[j]
				if instance ~= nil then
					if SEEN[instance] then table.clear(SEEN) return 9, N, budget - BUDGET end
					SEEN[instance] = true
				end
			end
			table.clear(SEEN)
			offset += ic
		end
	end
	local p = P
	if (p + 7) // 8 * 8 ~= S then return 4, N, budget - BUDGET end
	local pad = (8 - p % 8) % 8
	if pad > 0 and readbits(B, p, pad) ~= 0 then return 4, N, budget - BUDGET end
	if offset < instanceCount then return 9, N, budget - BUDGET end
	return 0, N, budget - BUDGET
end

G.defs = DEFS
G.values = VALS
G.names = NAMES

return G
]==])

print(table.concat(out, "\n"))

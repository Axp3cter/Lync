-- seed-0 offsets as constants
function M.encRmw_0(b: buffer, p: number, v: Rec): number
	do local o = p + 0; local by = o // 8
		writeu32(b, by, bor(readu32(b, by), lshift(if v.crit then 1 else 0, o % 8))) end
	do local o = p + 1; local by = o // 8
		writeu32(b, by, bor(readu32(b, by), lshift(v.damage, o % 8))) end
	do local o = p + 8; local by = o // 8
		writeu32(b, by, bor(readu32(b, by), lshift(v.target - 1, o % 8))) end
	do local o = p + 24; local by = o // 8
		writeu32(b, by, bor(readu32(b, by), lshift(q18(v.x), o % 8))) end
	do local o = p + 42; local by = o // 8
		writeu32(b, by, bor(readu32(b, by), lshift(q18(v.y), o % 8))) end
	do local o = p + 60; local by = o // 8
		writeu32(b, by, bor(readu32(b, by), lshift(q18(v.z), o % 8))) end
	return p + 78
end
-- per-session offsets as upvalues: one closure per session
function M.makeRmw(o1: number, o2: number, o3: number, o4: number, o5: number, o6: number): (buffer, number, Rec) -> number
	return function(b: buffer, p: number, v: Rec): number
		do local o = p + o1; local by = o // 8
			writeu32(b, by, bor(readu32(b, by), lshift(if v.crit then 1 else 0, o % 8))) end
		do local o = p + o2; local by = o // 8
			writeu32(b, by, bor(readu32(b, by), lshift(v.damage, o % 8))) end
		do local o = p + o3; local by = o // 8
			writeu32(b, by, bor(readu32(b, by), lshift(v.target - 1, o % 8))) end
		do local o = p + o4; local by = o // 8
			writeu32(b, by, bor(readu32(b, by), lshift(q18(v.x), o % 8))) end
		do local o = p + o5; local by = o // 8
			writeu32(b, by, bor(readu32(b, by), lshift(q18(v.y), o % 8))) end
		do local o = p + o6; local by = o // 8
			writeu32(b, by, bor(readu32(b, by), lshift(q18(v.z), o % 8))) end
		return p + 78
	end
end
function M.makeDec(o1: number, o2: number, o3: number, o4: number, o5: number, o6: number): (buffer, number, Rec) -> number
	return function(b: buffer, p: number, r: Rec): number
		do local o = p + o1; local q = band(rshift(readu32(b, o // 8), o % 8), 1)
			r.crit = q == 1 end
		do local o = p + o2; local q = band(rshift(readu32(b, o // 8), o % 8), 127)
			if q > 100 then return -1 end; r.damage = q end
		do local o = p + o3; local q = band(rshift(readu32(b, o // 8), o % 8), 65535)
			r.target = q + 1 end
		do local o = p + o4; local q = band(rshift(readu32(b, o // 8), o % 8), 262143)
			if q > 131072 then return -1 end; r.x = q / 32 - 2048 end
		do local o = p + o5; local q = band(rshift(readu32(b, o // 8), o % 8), 262143)
			if q > 131072 then return -1 end; r.y = q / 32 - 2048 end
		do local o = p + o6; local q = band(rshift(readu32(b, o // 8), o % 8), 262143)
			if q > 131072 then return -1 end; r.z = q / 32 - 2048 end
		return p + 78
	end
end
